DATABASE_URL=postgres://kaiban:kaiban@postgres:5432/kaiban?sslmode=disable
# локально без compose: postgres://kaiban:kaiban@localhost:5433/kaiban?sslmode=disable
HTTP_ADDR=:8080
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# OpenCode Zen (Settings → LLM → OpenCode Zen): https://opencode.ai/zen/v1
# Free models (e.g. space-bunny-free) work without a key; paid need OPENCODE_API_KEY pasted in UI.
# таймаут HTTP к LLM (стрим + ожидание тела)
LLM_HTTP_TIMEOUT=10m
GIT_WORK_DIR=/tmp/kaiban-git
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
GITHUB_URL=https://api.github.com
GITHUB_TOKEN=
GITLAB_URL=
GITLAB_TOKEN=
